# Copy to <repo root>/.env.fullpilot.local (gitignored). Loaded by every
# `npm run dev*` script on top of upstream's local dev env from the Makefile.

# Default Gmail path: Fullpilot's own web OAuth client. Its registered redirect
# is the production API, so locally it only works if you also register
# http://localhost:8080/addresses/google/callback on that client in the
# Google Cloud Console. Until then, use the desktop client path below.
#BOX_GOOGLE_CLIENT_ID=
#BOX_GOOGLE_CLIENT_SECRET=

# Alternative Gmail path: Thunderbird's public desktop client. Google only lets
# it redirect to localhost, so the connect modal asks the user to paste the
# address the consent window lands on. Works locally with no setup.
BOX_GOOGLE_DESKTOP_CLIENT_ID=406964657835-aq8lmia8j95dhl1a2bvharmfk3t1hgqj.apps.googleusercontent.com
BOX_GOOGLE_DESKTOP_CLIENT_SECRET=kSmqreRr0qwBWJgbf5Y-PjSU

# Microsoft 365: Thunderbird's public desktop client, same paste flow.
BOX_OUTLOOK_DESKTOP_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753
